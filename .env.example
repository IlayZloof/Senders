# העתיקו ל-.env.local והזינו את פרטי הפרויקט מ-Supabase (חינמי)
# בלי זה האתר עובד במצב מקומי (localStorage) — מתאים לפיתוח

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# אימיילי מנהל — מקבלים הרשאות admin אוטומטית (מופרדים בפסיק)
VITE_ADMIN_EMAIL=ilay@sendit.co.il,ilay.zloof@gmail.com

# ─── הגדרות Supabase (Dashboard) ───
# 1. Authentication → Providers → Email + Google
#    Google: Client ID + Secret מ-Google Cloud (OAuth client = Web application)
#    Redirect URI בגוגל: https://YOUR-PROJECT.supabase.co/auth/v1/callback
# 2. Authentication → URL Configuration → Redirect URLs:
#    http://localhost:5173/login.html
#    https://YOUR-LIVE-SITE/login.html
# 3. SQL Editor → הריצו: supabase/schema.sql ואז supabase/migrations/002_auth_admin.sql
#    ואז supabase/migrations/004_google_display_name.sql
#    ואז supabase/migrations/006_jump_videos.sql (פיד סרטונים בבית)
